# Specify files that shouldn't be modified by Fern

LICENSE
README.md

# The frozen openapi-generator SDK. Plaid owns this directory and publishes
# updates to it independently; Fern must never touch it.
legacy

# Hand-written CI. Fern manages .github/workflows and DELETES files there that
# it did not generate, so anything of ours must be listed explicitly.
.github/workflows/tidy.yml

# go.mod is deliberately NOT protected here, to test whether the tidy workflow
# can repair it after Fern overwrites it.
